# FlowForge server configuration
# Copy to .env and adjust. All values are optional with sensible demo defaults.

# HTTP port for the control-plane API
PORT=8080

# SQLite database file path (created automatically; persists across restarts)
DB_PATH=./flowforge.db

# --- AI authoring (OpenAI-compatible) ---------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, Azure OpenAI, OpenRouter,
# Groq, Together, Ollama (http://localhost:11434/v1), etc.
# If OPENAI_API_KEY is empty, authoring falls back to a deterministic local
# generator so the demo always works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
